# LLM provider: "anthropic" (default) or "openai" (OpenAI or any OpenAI-compatible API via LLM_BASE_URL)
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Used when LLM_API_KEY is empty
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: without it Tavily's keyless mode is used (lower rate limit)
TAVILY_API_KEY=
PORT=3000
DATABASE_PATH=./data/guides.db
